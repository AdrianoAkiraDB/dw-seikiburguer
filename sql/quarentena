As Regras do Nosso "Contrato de Dados" (O que vai para a Quarentena):
Um pedido irá para a quarentena se violar qualquer uma destas regras:
Quantidade menor ou igual a zero: quantidade <= 0
Preço negativo: preco_unitario < 0
Data no futuro: Pedidos lançados com data superior ao dia de amanhã.
Canal inválido: Canais que não sejam de 1 a 5.



-- 1. Criação da Tabela de Quarentena (Dead Letter Queue)
CREATE TABLE IF NOT EXISTS stg_vendas_rejeitadas (
    rejeicao_id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    pedido_id INTEGER,
    data_pedido DATE,
    horario TIME,
    canal_id INTEGER,
    cliente_id BIGINT,
    produto_id INTEGER,
    quantidade INTEGER,
    preco_unitario NUMERIC(10, 2),
    forma_pagamento_id INTEGER,
    taxa_entrega NUMERIC(10, 2),
    custo_entrega NUMERIC(10, 2),
    cupom_desconto NUMERIC(10, 2),
    cashback_usado NUMERIC(10, 2),
    taxa_comissao NUMERIC(10, 2),
    status_pedido VARCHAR(50),
    motivo_rejeicao TEXT NOT NULL,
    data_rejeicao TIMESTAMPTZ DEFAULT NOW()
);

-- 2. Habilitação de Segurança (RLS)
ALTER TABLE stg_vendas_rejeitadas ENABLE ROW LEVEL SECURITY;

-- 3. Política para leitura de registros rejeitados
CREATE POLICY "Permitir leitura quarentena" 
ON stg_vendas_rejeitadas 
FOR SELECT 
USING (true);
